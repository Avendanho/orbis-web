# =============================================================================
# .env.example — copie para .env e preencha os valores reais
# =============================================================================
# IMPORTANTE: cada variável deve estar em uma linha separada (sem aspas ao redor
# dos valores). Use python-dotenv ≥ 1.0 para carregá-las corretamente.
# =============================================================================

# ---------------------------------------------------------------------------
# Fontes de metadados OA (obrigatórias para maximizar taxa de sucesso)
# ---------------------------------------------------------------------------

# E-mail cadastrado no Unpaywall — necessário para consultar a API pública.
# Registre em: https://unpaywall.org/products/api
UNPAYWALL_EMAIL=seuemail@exemplo.com

# E-mail polite para Crossref (melhora rate-limit; não é obrigatório)
CROSSREF_MAILTO=seuemail@exemplo.com

# E-mail para a OpenAlex (identificação educada)
OPENALEX_MAILTO=seuemail@exemplo.com

# Chave GRATUITA da OpenAlex — muito recomendada. Desde 2026 o uso anônimo tem
# cota diária pequena por IP (esgota em poucas centenas de consultas). Com a
# chave, a OpenAlex também serve a cópia em cache do PDF (fonte
# "openalex_content", ~100 PDFs/dia no plano gratuito).
# Crie em: https://openalex.org/settings/api
# OPENALEX_API_KEY=sua_chave_openalex

# Chave do Semantic Scholar — opcional; evita o limite do pool anônimo.
# Solicite em: https://www.semanticscholar.org/product/api#api-key-form
# SEMANTIC_SCHOLAR_API_KEY=sua_chave_s2

# ---------------------------------------------------------------------------
# APIs de acesso institucional / editorial
# ---------------------------------------------------------------------------

# Chave de API Elsevier/ScienceDirect.
# ATENÇÃO: a chave sozinha quase nunca basta. Ela identifica você, mas quem
# concede o acesso é o *entitlement* da instituição — sem ele a API responde
# 403 AUTHENTICATION_ERROR para TODOS os artigos, não só para alguns.
# Para checar a sua antes de confiar nela:
#   curl -H "X-ELS-APIKey: $ELSEVIER_API_KEY" \
#     "https://api.elsevier.com/content/article/entitlement/doi/10.1016/j.cell.2020.01.001"
# Se vier AUTHENTICATION_ERROR, peça o insttoken à biblioteca
# (datasupportRD@elsevier.com) e preencha ELSEVIER_INST_TOKEN abaixo. Enquanto
# isso, o pipeline desiste dessa rota após 3 recusas seguidas, em vez de gastar
# uma requisição inútil por artigo.
# Obtenha em: https://dev.elsevier.com/
ELSEVIER_API_KEY=sua_chave_elsevier

# Token institucional da Elsevier — é ele que carrega o direito de acesso.
# ELSEVIER_INST_TOKEN=seu_insttoken

# Chave de API Springer/Nature — opcional, melhora acesso a artigos Springer.
# Obtenha em: https://dev.springernature.com/
SPRINGER_API_KEY=sua_chave_springer

# Chaves de busca: Scopus (também usa ELSEVIER_API_KEY) e IEEE Xplore.
# Obtenha em: https://dev.elsevier.com/ e https://developer.ieee.org/
# SCOPUS_API_KEY=sua_chave_scopus
# IEEE_API_KEY=sua_chave_ieee

# Máximo de registros baixados por base na etapa de busca (padrão 2000).
# SEARCH_MAX_RESULTS=2000

# Chave de API CORE — fonte de acesso aberto complementar.
# Obtenha em: https://core.ac.uk/services/api
CORE_API_KEY=sua_chave_core

# ---------------------------------------------------------------------------
# Provedores de IA (análise de artigos — src/analysis/)
# ---------------------------------------------------------------------------

# Pelo menos um deve ser configurado para o comando `analyze` funcionar.

# Google Gemini (recomendado — melhor custo-benefício)
GEMINI_API_KEY=sua_chave_gemini

# Anthropic Claude (fallback)
# ANTHROPIC_API_KEY=sua_chave_claude

# OpenAI (segundo fallback)
# OPENAI_API_KEY=sua_chave_openai

# Ollama local (terceiro fallback — sem custo, mas requer instalação local)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5

# ---------------------------------------------------------------------------
# Flags de modo de download (src/download/)
# ---------------------------------------------------------------------------

# Habilitar modo institucional: tenta baixar via DOI direto nos portais
# editoriais usando as chaves de API acima. Recomendado quando há acesso
# institucional (ex.: VPN da universidade ou chaves de API válidas).
# PAPER_FETCH_INSTITUTIONAL=1

# Habilitar CloakBrowser (Playwright headless) como fallback para páginas
# protegidas por Cloudflare / DDoS-Guard. Requer playwright instalado.
# PAPER_FETCH_CLOAK=1

# Desabilitar Sci-Hub permanentemente (ex.: conformidade institucional).
# Por padrão, o circuit breaker já desativa automaticamente após 5 falhas
# consecutivas de rede — use esta flag somente para desabilitação explícita.
# PAPER_FETCH_NO_SCIHUB=1

# Sobrescrever lista de mirrors do Sci-Hub (separados por vírgula).
# PAPER_FETCH_SCIHUB_MIRRORS=sci-hub.al,sci-hub.mk,sci-hub.ru

# Sobrescrever lista de mirrors da Anna's Archive (separados por vírgula).
# PAPER_FETCH_ANNAS_ARCHIVE_MIRRORS=https://annas-archive.pk,https://annas-archive.gd

# Chave de API da Anna's Archive (desbloqueia fast-download sem redirecionamento).
# ANNAS_ARCHIVE_KEY=sua_chave_annas_archive

# ---------------------------------------------------------------------------
# PMC Open Access via AWS — não precisa de configuração nenhuma
# ---------------------------------------------------------------------------
# O NIH publica o acervo de acesso aberto do PMC em um bucket S3 público
# (pmc-oa-opendata). É a única via do PMC que ainda atende cliente HTTP: as
# páginas de artigo passaram a responder com um desafio reCAPTCHA e o antigo
# serviço oa.fcgi foi desligado na migração de agosto/2026.
# A fonte "pmc_s3" usa esse bucket automaticamente — sem chave, sem limite de
# requisições. Quando o bucket só tem o XML (JATS) e não o PDF, o texto
# completo é renderizado em PDF e passa pela mesma checagem de identidade.
# Nada a preencher aqui; esta seção existe só para registrar a rota.

# ---------------------------------------------------------------------------
# Acesso institucional (o que a sua universidade já assina)
# ---------------------------------------------------------------------------

# EZproxy da biblioteca: quando um PDF licenciado responde 403, ele é buscado
# de novo por aqui. Sem usuário/senha, o servidor ainda pode autorizar por IP.
# EZPROXY_BASE_URL=https://ezproxy.pucminas.br
# EZPROXY_USER=seu_usuario
# EZPROXY_PASSWORD=sua_senha

# Navegador headless (Playwright) para repositórios que montam a página em
# JavaScript (DSpace 7, Pure, portais Figshare). Só atua em repositórios
# institucionais; identifica-se com o e-mail acima e faz 1 requisição/s.
# Requer: playwright install chromium
# PAPER_FETCH_BROWSER=1
# Hosts extras liberados para o navegador (lista separada por vírgulas).
# PAPER_FETCH_BROWSER_HOSTS=repositorio.pucminas.br

# Proxy institucional (ex.: PUC Minas, USP, UNICAMP) — formato standard.
# Descomente e configure caso sua instituição forneça um proxy SOCKS5/HTTP.
# PAPER_FETCH_PROXY=socks5://proxy.pucminas.br:1080
# ou
# HTTP_PROXY=http://proxy.pucminas.br:3128
# HTTPS_PROXY=http://proxy.pucminas.br:3128

# ---------------------------------------------------------------------------
# Configurações internas (normalmente não precisam ser alteradas)
# ---------------------------------------------------------------------------

# Limitar fontes consultadas (útil para debug). Separados por vírgula.
# Fontes disponíveis: unpaywall, semantic_scholar, openalex, europe_pmc,
# pmc, pubmed, arxiv, biorxiv, acl_anthology, core, libgen, crossref,
# publisher_direct, publisher_xml, doi_resolver, oa_button, osti, openalex_content,
# wayback, openaire, hal, zenodo, datacite, doaj, dryad, figshare, ntrs, base,
# fatcat, scihub, annas_archive

# Desligar a OSTI (manuscritos aceitos de artigos financiados pelo DOE/EUA).
# PAPER_FETCH_NO_OSTI=1

# Desligar a BASE (exige cadastro do IP em base-search.net) ou o fatcat/
# Internet Archive Scholar.
# PAPER_FETCH_NO_BASE=1
# PAPER_FETCH_NO_FATCAT=1

# Desligar a cópia arquivada da Wayback Machine para URLs OA que falharam.
# PAPER_FETCH_NO_WAYBACK=1

# Desligar o download da cópia em cache da OpenAlex (consome créditos da chave).
# PAPER_FETCH_NO_OPENALEX_CONTENT=1
# PAPER_FETCH_SOURCES=unpaywall,semantic_scholar,libgen


# Token Wiley Text and Data Mining (acesso licenciado legítimo)
# WILEY_TDM_TOKEN=seu_token_wiley
